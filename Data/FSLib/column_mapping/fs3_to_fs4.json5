// FS-3 -> FS-4 column mapping (issue #80, DBC Column Mapping Roadmap, Decisions 2 and 3).
// Second link of the chain FS-2 -> FS-3 -> FS-4 (global). read() applies it in memory to FS-3 logs,
// and to FS-2 logs after fs2_to_fs3.json5. FS-4 names are the global names (global_schema.json5).
//
// SCOPE: every row of dbc_message_map.csv that has an FS-3 or FS-4 message.
//
// Resolution order, entry formats, template rules and `candidate` work exactly as described in the
// header of fs2_to_fs3.json5. Removed columns go to legacy.fs3.<key>.
//
// Keys: a key is the bare signal name, which is how FS-3 parquets name their columns. Every FS-3
// signal name is unique across messages, so no MESSAGE.SIGNAL keys are needed. SYNC and
// SMPC_UNKNOWN_1..4 have no signals and produce no columns.
//
// SME_THROTL_UNUSED_* and SME_CURRLIM_UNUSED_INT_1 appear in 3 of 9 FS-3 log eras although the FS-3
// DBC does not define them (those logs were decoded with the FS-2 SME messages). The global
// filler_patterns drop them; nothing here.
{
  format_version: 1,
  from: {
    car: "FS-3",
    dbcs: [
      {path: "fs-3/CANbus.dbc", sha256: "652f62aaba174d68fe8dee57d881fd8f45b0a44b3a5d2a8b9514ae8a80326108", commit: "4df137cee51e27738df7805e39eaedbd6d723855", commit_date: "2026-02-14"},
    ],
  },
  to: {
    car: "FS-4",
    dbcs: [
      {path: "fs-4-firmware/CANbus.dbc", sha256: "ae0524d53e2efb81655c454373ee93d7ac2c001e8d511466aab99bf8617396a2", commit: "0edcdfa71d3bd5aee045784d81ef73a2774e5af9", commit_date: "2026-10-04"},
    ],
  },
  created: "2026-11-20",

  drop: [],

  // Same name, same meaning, same unit on FS-4.
  unchanged: [
    // SME_RPDO_Throttle_Demand (0x186)
    "SME_THROTL_PowerReady", "SME_THROTL_MBB_Alive", "SME_THROTL_Reverse", "SME_THROTL_Forward",
    "SME_THROTL_MaxSpeed", "SME_THROTL_TorqueDemand",
    // SME_RPDO_Max_Currents (0x286)
    "SME_CURRLIM_ChargeCurrentLim", "SME_CURRLIM_DischargeCurrentLim",
    // SME_TPDO_Torque_speed (0x482). Key_switch_* casing is fixed under `renames`.
    "SME_TRQSPD_SOC_Low_Traction", "SME_TRQSPD_SOC_Low_Hydraulic", "SME_TRQSPD_Reverse", "SME_TRQSPD_Forward",
    "SME_TRQSPD_Park_Brake", "SME_TRQSPD_Pedal_Brake", "SME_TRQSPD_Controller_Overtermp", "SME_TRQSPD_Running",
    "SME_TRQSPD_Traction", "SME_TRQSPD_Hydraulic", "SME_TRQSPD_Powering_Enabled", "SME_TRQSPD_Powering_Ready",
    "SME_TRQSPD_contactor_closed", "SME_TRQSPD_Precharging", "SME_TRQSPD_Speed", "SME_TRQSPD_MotorFlags",
    "SME_TRQSPD_Torque",
    // SME_TPDO_Temperature (0x682)
    "SME_TEMP_FaultLevel", "SME_TEMP_FaultCode", "SME_TEMP_DC_Bus_V", "SME_TEMP_ControllerTemperature",
    "SME_TEMP_MotorTemperature", "SME_TEMP_BusCurrent",
    // LSS_COMMAND (0x7E5) / LSS_RESPONSE (0x7E4)
    "COMMAND_MODE", "COMMAND_COMMAND_SPECIFIER", "RESPONSE_COMMAND_SPECIFIER",
    // SMPC_RPDO_CONTROL (0x206)
    "SMPC_CONTROL_PACK_VOLTAGE", "SMPC_CONTROL_DEST_NODE_ID", "SMPC_CONTROL_ENABLE",
    "SMPC_CONTROL_CURRENT_10X_MULT", "SMPC_CONTROL_EVSE_OVERRIDE",
    // SMPC_RPDO_MAX_VOLTAGE_CURRENT (0x306)
    "SMPC_MAX_DEST_NODE_ID", "SMPC_MAX_CHRG_VOLTAGE", "SMPC_MAX_CHRG_CURRENT", "SMPC_MAX_INPUT_EVSE_OVERRIDE",
    // SMPC_TPDO_STATUS (0x190)
    "SMPC_STATUS_CURRENT_MA", "SMPC_STATUS_VOLTAGE_MV", "SMPC_STATUS_J1772_DISCONN", "SMPC_STATUS_REQUEST_EXCLUSIVE",
    "SMPC_STATUS_CHARGER_UNPLUGGED", "SMPC_STATUS_CHARGING", "SMPC_STATUS_INTERNAL_FAULT",
    "SMPC_STATUS_UNDERVOLTAGE_FAULT", "SMPC_STATUS_OVERVOLTAGE_FAULT", "SMPC_STATUS_OVERCURRENT_FAULT",
    "SMPC_STATUS_OVERTEMP_FAULT", "SMPC_STATUS_CHARGE_COMPLETE", "SMPC_STATUS_READY",
    // SMPC_TPDO_MAX_VOLTAGE_CURRENT (0x290)
    "SMPC_MAX2_INPUT_CURR_LIM", "SMPC_MAX2_EVSE_CURRENT", "SMPC_MAX2_MAX_CURRENT_MA", "SMPC_MAX2_MAX_VOLTAGE_MV",
    // SMPC_TPDO_INPUT_AC (0x390)
    "SMPC_INPUT_MAX_CHARGER_TEMP_C", "SMPC_INPUT_AC_INPUT_FREQUENCY_HZ", "SMPC_INPUT_AC_INPUT_CURRENT_MA",
    "SMPC_INPUT_J1772_TRIGGERED", "SMPC_INPUT_J1772_DISCONNECTED", "SMPC_INPUT_J1772_CONNECTED",
    "SMPC_INPUT_AC_INPUT_VOLTAGE",
    // SMPC_TPDO_SERIAL_PART_NUM (0x490)
    "SMPC_SER_FIRMWARE_VER", "SMPC_SER_SERIAL_NUMBER", "SMPC_SER_PART_NUMBER",
    // IZZE_BRAKETEMP_S1M1..M5 (0x4C4..0x4C8)
    "IZZE_BRAKETEMP_S1_CH1", "IZZE_BRAKETEMP_S1_CH2", "IZZE_BRAKETEMP_S1_CH3", "IZZE_BRAKETEMP_S1_CH4",
    "IZZE_BRAKETEMP_S1_CH5", "IZZE_BRAKETEMP_S1_CH6", "IZZE_BRAKETEMP_S1_CH7", "IZZE_BRAKETEMP_S1_CH8",
    "IZZE_BRAKETEMP_S1_CH9", "IZZE_BRAKETEMP_S1_CH10", "IZZE_BRAKETEMP_S1_CH11", "IZZE_BRAKETEMP_S1_CH12",
    "IZZE_BRAKETEMP_S1_CH13", "IZZE_BRAKETEMP_S1_CH14", "IZZE_BRAKETEMP_S1_CH15", "IZZE_BRAKETEMP_S1_CH16",
    "IZZE_BRAKETEMP_S1_STEMP",
    // VDM_GPS_COORDINATES (FS-3) = VDM_GPS_LAT_LONG (FS-4), same CAN ID 0xA0000. See header: no transform.
    "VDM_GPS_Latitude", "VDM_GPS_Longitude",
    // VDM_GPS_DATA (0xA0001)
    "VDM_GPS_SPEED", "VDM_GPS_ALTITUDE", "VDM_GPS_TRUE_COURSE", "VDM_GPS_SATELLITES_IN_USE", "VDM_GPS_VALID1",
    // VDM_DATE_TIME (0xA0002). Byte-shifted in some FS-3 logs, see header.
    "VDM_GPS_VALID2", "VDM_UTC_DATE_YEAR", "VDM_UTC_DATE_MONTH", "VDM_UTC_DATE_DAY",
    "VDM_UTC_TIME_HOURS", "VDM_UTC_TIME_MINUTES", "VDM_UTC_TIME_SECONDS",
    // VDM_ACCELERATION (0xA0003) / VDM_YAW_RATE (0xA0004)
    "VDM_X_AXIS_ACCELERATION", "VDM_Y_AXIS_ACCELERATION", "VDM_Z_AXIS_ACCELERATION",
    "VDM_X_AXIS_YAW_RATE", "VDM_Y_AXIS_YAW_RATE", "VDM_Z_AXIS_YAW_RATE",
  ],

  renames: {
    // SME_TPDO_Torque_speed (0x482): casing only.
    "SME_TRQSPD_Key_switch_overvolt": "SME_TRQSPD_Key_Switch_Overvolt",
    "SME_TRQSPD_Key_switch_undervolt": "SME_TRQSPD_Key_Switch_Undervolt",

    // ETC_TPDO_STATUS (0x189) -> VCU_TPDO_PEDAL_TRAVEL (0x192). Pedal sensors moved from ETC to VCU.
    "ETC_STATUS_HE1": "VCU_APPS1_HE",                    // mV
    "ETC_STATUS_HE2": "VCU_APPS2_HE",                    // mV
    "ETC_STATUS_PEDAL_TRAVEL": "VCU_ACCEL_PEDAL_TRAVEL", // %

    // ETC_TPDO_STATUS (0x189) -> VCU_TPDO_STATUS (0x193)
    "ETC_STATUS_RTD": "VCU_ETC_READY_TO_DRIVE",
    "ETC_STATUS_RTD_BUTTON": "VCU_ETC_RTD_BUTTON_PRESSED",
    "ETC_STATUS_REVERSE": "VCU_ETC_REVERSE",
    "ETC_STATUS_BRAKELIGHT": "VCU_ETC_BRAKELIGHT",
    "ETC_STATUS_TS_ACTIVE": "VCU_ETC_BATT_PRECHARGE_DONE", // renamed per FS-4 DBC comment, see header

    // TMAIN_TPDO_DATA (0x1A0) -> VCU_TPDO_STATUS (0x193). psi on both cars.
    "TMAIN_DATA_BRAKES_F": "VCU_BRAKE_PRESSSURE_FRONT", // FS-4 spells PRESSSURE with three S
    "TMAIN_DATA_BRAKES_R": "VCU_BRAKE_PRESSSURE_REAR",

    // ACC_TPDO_STATUS (0x188) -> BATT_TPDO_STATUS (0x391). ACC board renamed BATT.
    "ACC_STATUS_BMS_FAULT": "BATT_STATUS_BMS_FAULT",
    "ACC_STATUS_IMD_FAULT": "BATT_STATUS_IMD_FAULT",
    "ACC_STATUS_PRECHARGE_DONE": "BATT_STATUS_PRECHARGE_DONE",
    "ACC_STATUS_PRECHARGING": "BATT_STATUS_PRECHARGING",
    "ACC_STATUS_CHARGING": "BATT_STATUS_CHARGING",
    "ACC_STATUS_BALANCING": "BATT_STATUS_BALANCING",
    "ACC_STATUS_CELL_TOO_LOW": "BATT_STATUS_CELL_VOLTAGE_TOO_LOW",
    "ACC_STATUS_CELL_TOO_HIGH": "BATT_STATUS_CELL_VOLTAGE_TOO_HIGH",
    "ACC_STATUS_TEMP_TOO_LOW": "BATT_STATUS_PACK_TEMP_TOO_LOW",
    "ACC_STATUS_TEMP_TOO_HIGH": "BATT_STATUS_PACK_TEMP_TOO_HIGH",
    "ACC_STATUS_TEMP_TOO_HIGH_CRG": "BATT_STATUS_PACK_TEMP_TOO_HIGH_CRG",
    // FS-3 logs hold this in three units depending on the file (checked 2026-11-22, all 142 files),
    // even within one folder (11222025), so the scale is picked per file from the median non-zero
    // value. GLV is a ~12-13 V system, so the ranges cannot be confused. Other FS-3 voltages (pack,
    // cells, DC bus, HE sensors) use one scale everywhere.
    "ACC_STATUS_GLV_VOLTAGE": {to: "BATT_STATUS_GLV_VOLTAGE", by_value: [
      {min: 1000, scale: 0.001, note: "mV"},           // ~13000: 01112026, 01172026, most of 11222025
      {min: 50, max: 1000, scale: 0.1, note: "0.1 V"}, // ~120-132: Aug-Nov 2025, PreparedData, 11222025_1/2/21
      {min: 5, max: 30, scale: 1, note: "V"},          // ~12: 03162026
    ]},

    // ACC_TPDO_POWER (0x288) -> BATT_TPDO_POWER (0x392)
    "ACC_POWER_PACK_VOLTAGE": "BATT_POWER_PACK_VOLTAGE", // V
    "ACC_POWER_CURRENT": "BATT_POWER_CURRENT",           // A
    "ACC_POWER_SOC": "BATT_POWER_SOC",                   // %; FS-3 1% steps, FS-4 0.1%. Resolution only.

    // ACC_TPDO_TRAY_TEMPS (0x388) -> BATT_TPDO_TRAY_TEMPS (0x4C0). Same 0.5 C encoding.
    "ACC_TRAY_TEMPS_BOLTED_CONNECTION": "BATT_TRAY_TEMPS_BOLTED_CONNECTION",
    "ACC_TRAY_TEMPS_BUSBAR": "BATT_TRAY_TEMPS_SENTRALITY_BUSBAR", // FS-4 renamed BUSBAR (see global_schema aliases)
    "ACC_TRAY_TEMPS_PACK_FUSE": "BATT_TRAY_TEMPS_PACK_FUSE",
    "ACC_TRAY_TEMPS_COWLING": "BATT_TRAY_TEMPS_COWLING",
    "ACC_TRAY_TEMPS_INTAKE": "BATT_TRAY_TEMPS_INTAKE",
  },

  rules: [
    // ACC_TPDO_SEG0..4_VOLTS (0x191..0x195) -> BATT_TPDO_MOD0..4_VOLTS. Same 6 cells, same 0.01 V +2 encoding.
    {from: "ACC_SEG{i}_VOLTS_CELL{j}", to: "BATT_MOD{i}_VOLTS_CELL{j}", vars: {i: [0, 1, 2, 3, 4], j: [0, 1, 2, 3, 4, 5]}},

    // TPERIPH_*_TPDO_DATA (FS-3 0x1A2..0x1A5 -> FS-4 0x1A5..0x1A8) and TPERIPH_*_TPDO_TIRETEMP
    // (0x2A1..0x2A4 -> 0x2A5..0x2A8). Names unchanged, only CAN IDs moved; units match.
    {from: "TPERIPH_{c}_DATA_{s}", to: "TPERIPH_{c}_DATA_{s}", vars: {c: ["FL", "FR", "BL", "BR"], s: ["WHEELSPEED", "SUSTRAVEL", "STRAIN", "SIDE_TIRE_TEMP"]}},
    {from: "TPERIPH_{c}_TIRETEMP_{k}", to: "TPERIPH_{c}_TIRETEMP_{k}", vars: {c: ["FL", "FR", "BL", "BR"], k: [1, 2, 3, 4, 5, 6, 7, 8]}},
  ],

  // Moved to legacy.fs3.<key>.
  removed: {
    // ETC_TPDO_STATUS / ETC_TPDO_STATUS_2
    "ETC_STATUS_BRAKE_SENSE_VOLTAGE": {candidate: "VCU_BPPS_HE", reason: "Both mV, but unconfirmed that FS-3 'brake sense' is the brake pedal position sensor and not a pressure sensor."},
    "ETC_STATUS_BRAKE_PEDAL_TRAVEL": {candidate: "VCU_BRAKE_PEDAL_TRAVEL", reason: "DBC unit 'thouPerCent' (0..1000) disagrees with logged values (p99 73); unknown whether x0.1 is needed."},
    "ETC_STATUS_CAN_REGEN": {candidate: "VCU_ETC_REGEN_ALLOWED", reason: "Likely the same regen-enable flag; unconfirmed."},
    "ETC_STATUS_RTDS": {reason: "Ready-to-drive sound output. FS-4 has no equivalent."},
    "ETC_STATUS_IMPLAUSIBILITY": {reason: "Single flag. FS-4 splits it into five VCU_ETC_IMPLAUS_* flags; their OR would match, but there is no combine entry type."},

    // TMAIN_TPDO_DATA
    "TMAIN_DATA_STEERING": {candidate: "VCU_STEERING_ANGLE", reason: "Both deg, but a different sensor/board; zero and sign convention unverified."},

    // ACC_TPDO_STATUS
    "ACC_STATUS_SHUTDOWN_STATE": {candidate: "BATT_STATUS_SHUTDOWN_FINAL", reason: "FS-4 reads the shutdown circuit at three points (IN/OUT/FINAL); unclear which one FS-3 measured."},
    "ACC_STATUS_CELL_FAULT_INDEX": {reason: "32-bit value reaching 2^30 - 1, not the 0..60 index of BATT_STATUS_FAULT_INDEX. Likely a bitmask."},

    // VDM_DATE_TIME
    "VDM_RESERVED_BYTE": {candidate: "VDM_UTC_TIME_SECONDS", reason: "Only exists because of the FS-3 DBC's shifted layout; holds the real UTC seconds in logs decoded with it. See header."},
  },

  removed_rules: [
    // ACC_TPDO_SEG0..4_TEMPS (0x291..0x295). Decision 3c (on hold): FS-3 has 6 signed 1 C sensors per
    // segment, FS-4 has 12 per module (TEMPS_A/B, 0.25 C) and the physical correspondence is unknown.
    {from: "ACC_SEG{i}_TEMPS_CELL{j}", vars: {i: [0, 1, 2, 3, 4], j: [0, 1, 2, 3, 4, 5]}, reason: "Decision 3c: FS-3 -> FS-4 thermistor layout unknown."},
  ],

  // Every signal of these messages goes to legacy. Signal names are unique, so qualify: false.
  removed_messages: {
    // Roadmap: PDB board dropped in FS-4. Currents are raw 'lsb' counts.
    "PDB_TPDO_POWER_A": {qualify: false},
    "PDB_TPDO_POWER_B": {qualify: false},
  },

  // Logged columns that the FS-3 DBC does not define. All go to legacy.fs3.<name>.
  non_dbc: {
    "ACC_TRAY_TEMPS_IMD_ANALOG": {origin: "old_dbc", reason: "From an earlier FS-3 DBC revision; never non-zero in any log."},
    "TRACTION_CONTROL_SETPOINT_ERROR": {origin: "derived", reason: "FS-3 traction-control test logs (03162026). Not the same quantity as any VCU_TRAC_* signal."},
    "timestamp": {origin: "derived", reason: "Seconds, in 4 logs from 10082025/10112025 that lack Time_ms."},
    "Lap": {origin: "derived", reason: "Lap number added to PreparedData/CombinedEndurance."},
  },

  // FS-4 signals in the messages above with no FS-3 source. Informational, for the coverage test and changelog.
  // Targets that are only a `candidate` above count as added until promoted.
  added: [
    // VCU_TPDO_PEDAL_TRAVEL (0x192)
    "VCU_BPPS_HE", "VCU_BRAKE_PEDAL_TRAVEL",
    // VCU_TPDO_STATUS (0x193)
    "VCU_ETC_REGEN_ALLOWED", "VCU_STEERING_ANGLE", "VCU_ETC_MOTOR_ENABLED",
    "VCU_ETC_IMPLAUS_APPS_OUT_OF_RANGE", "VCU_ETC_IMPLAUS_BPPS_OUT_OF_RANGE",
