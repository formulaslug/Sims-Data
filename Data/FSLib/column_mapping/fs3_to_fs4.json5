    // STEERING_DIAL_MODES (0x1B0). New in FS-4.
    "STEERING_DRIVE_MODE", "STEERING_TRACTION_MODE", "STEERING_REGEN_MODE",
    // VectorNav IMU (VCU_VN_*). New in FS-4.
    "VCU_VN_BODY_AF", "VCU_VN_BODY_AR", "VCU_VN_BODY_AD",
