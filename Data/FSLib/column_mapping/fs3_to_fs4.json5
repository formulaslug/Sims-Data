    "VCU_ETC_SOLENOID_CLOSED", "VCU_BSPD_FAULT", "VCU_BSPD_SHUTDOWN_OUT",
    // VCU_TPDO_TRACTION_DATA (0x294). New in FS-4; ID 660 was ACC_TPDO_SEG3_TEMPS on FS-3.
    "VCU_TRAC_WHEEL_SLIP", "VCU_TRAC_TORQUE_REDUCTION", "VCU_TRAC_INTEGRATOR", "VCU_TRAC_LOOP_TIME",
    "VCU_TRAC_RAW_DERIV", "VCU_TRAC_SMOOTHED_DERIV",
    // BATT_TPDO_STATUS (0x391)
    "BATT_STATUS_SHUTDOWN_FINAL", "BATT_STATUS_FAULT_INDEX",
    "BATT_STATUS_SHUTDOWN_IN", "BATT_STATUS_SHUTDOWN_OUT", "BATT_STATUS_FAULT_MODULE_INDEX",
    "BATT_STATUS_FAULT_SENSOR_INDEX", "BATT_STATUS_FAN_PWM_DUTY",
    // BATT_TPDO_POWER (0x392)
    "BATT_POWER_INSTANTANEOUS_POWER",
    // BATT_TPDO_CELL_STATS (0x393). FS-3 has no summary-stats message.
    "BATT_STAT_AVG_CELL_TEMP", "BATT_STAT_HIGH_CELL_TEMP", "BATT_STAT_LOW_CELL_TEMP",
    "BATT_STAT_AVG_CELL_VOLT", "BATT_STAT_HIGH_CELL_VOLT", "BATT_STAT_LOW_CELL_VOLT",
    // BATT_TPDO_MOD0..4_TEMPS_A/B. FS-3 segment temps are held in legacy (Decision 3c).
    "BATT_MOD0_TEMPS_CELL0", "BATT_MOD0_TEMPS_CELL1", "BATT_MOD0_TEMPS_CELL2", "BATT_MOD0_TEMPS_CELL3", "BATT_MOD0_TEMPS_CELL4", "BATT_MOD0_TEMPS_CELL5",
    "BATT_MOD0_TEMPS_CELL6", "BATT_MOD0_TEMPS_CELL7", "BATT_MOD0_TEMPS_CELL8", "BATT_MOD0_TEMPS_CELL9", "BATT_MOD0_TEMPS_CELL10", "BATT_MOD0_TEMPS_CELL11",
    "BATT_MOD1_TEMPS_CELL0", "BATT_MOD1_TEMPS_CELL1", "BATT_MOD1_TEMPS_CELL2", "BATT_MOD1_TEMPS_CELL3", "BATT_MOD1_TEMPS_CELL4", "BATT_MOD1_TEMPS_CELL5",
    "BATT_MOD1_TEMPS_CELL6", "BATT_MOD1_TEMPS_CELL7", "BATT_MOD1_TEMPS_CELL8", "BATT_MOD1_TEMPS_CELL9", "BATT_MOD1_TEMPS_CELL10", "BATT_MOD1_TEMPS_CELL11",
    "BATT_MOD2_TEMPS_CELL0", "BATT_MOD2_TEMPS_CELL1", "BATT_MOD2_TEMPS_CELL2", "BATT_MOD2_TEMPS_CELL3", "BATT_MOD2_TEMPS_CELL4", "BATT_MOD2_TEMPS_CELL5",
