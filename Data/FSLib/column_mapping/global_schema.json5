// Global column schema: FS-4 signal names, frozen (issue #80, DBC Column Mapping Roadmap, Decision 1).
// Created from fs-4-firmware/CANbus.dbc at commit 0edcdfa (2026-10-04); see `source` below.
// This file is maintained by hand. Never rename or delete an entry in `columns`: every name here
// is a public column that analysis scripts depend on. To retire a name, map it to legacy in a
// transition file; to accept another spelling of a name, add it under `aliases`.
//
// Rules:
//   * Names are kept verbatim from the FS-4 DBC.
//   * Each name has exactly one unit. Older cars are converted to it by `transform` entries.
//   * Signals first seen on a later car (FS-5+) are appended under their own name and frozen.
//     A later car's signal whose name matches an entry here but means something else must be
//     mapped explicitly; the coverage test rejects silent reuse.
//   * Columns retired from the global set live as legacy.<car>.<original name>, e.g.
//     legacy.fs3.PDB_..., and are not listed here.
{
  schema_version: 1,
  frozen: true,
  source: {
    car: "FS-4",
    dbc: "fs-4-firmware/CANbus.dbc",
    dbc_sha256: "ae0524d53e2efb81655c454373ee93d7ac2c001e8d511466aab99bf8617396a2",
    dbc_commit: "0edcdfa71d3bd5aee045784d81ef73a2774e5af9",
    dbc_commit_date: "2026-10-04",
    dbc_dirty_at_freeze: false,
    created: "2026-11-10",
  },

  // Filler patterns, matched anywhere in the name. Matching signals are dropped on read and never become global names.
  filler_patterns: ["(^|_)UNUSED_", "^SMPC_UNKNOWN_", "^IGNORE", "^ERR$"],
  excluded_at_freeze: [],

  // Non-DBC columns. Mappings may not rename, transform or drop these.
  reserved: {
    "Time_ms": {"unit": "ms", "description": "Logger timestamp. In all FS-4 logs and in FS-3 logs from Oct 2025 on."},
    "Time": {"unit": "s", "description": "Added by read(): Time_ms / 1000."},
  },

  // Other spelling (older or corrected) -> frozen name. read() renames these to the frozen name.
  // Each entry needs evidence that it is the same signal, not just a similar name.
  aliases: {
    // fs-4-firmware f400ba26 (2026-09-19) renamed it, same bit layout. 61 FS-4 logs use the old name.
    "BATT_TRAY_TEMPS_BUSBAR": "BATT_TRAY_TEMPS_SENTRALITY_BUSBAR",
    // VectorNav GNSS fix field, logged under this name before 91b231f9 (2026-10-01) re-added it. 42 FS-4 logs.
    "VCU_VN_GnssFix": "VCU_VN_GNSS_FIX",
  },

  // 328 columns, in DBC order. resolution/range are informational (FS-4 encoding).
  columns: {
